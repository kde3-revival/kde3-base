#!/bin/sh
#
#  DEFAULT KDE STARTUP SCRIPT ( KDE-3.5.10 )
#

# When the X server dies we get a HUP signal from xinit. We must ignore it
# because we still need to do some cleanup.
trap 'echo GOT SIGHUP' HUP

# in case we have been started with full pathname spec without being in PATH
bindir=`echo "$0" | sed -n 's,^\(/.*\)/[^/][^/]*$,\1,p'`
if [ -n "$bindir" ]; then
  case $PATH in
    $bindir|$bindir:*|*:$bindir|*:$bindir:*) ;;
    *) PATH=$bindir:$PATH; export PATH;;
  esac
fi

# Check if a KDE session already is running
if kcheckrunning >/dev/null 2>&1; then
	echo "KDE seems to be already running on this display."
	kstartupx --message "KDE seems to be already running on this display." > /dev/null 2>/dev/null
	exit 1
fi

# The desktop's names for the freedesktop.org specifications (autostart
# OnlyShowIn/NotShowIn, menus, xdg-desktop-portal's DESKTOP-portals.conf,
# xdg-utils, ...).  KDE3 first, then GNOME as a fallback: the applications
# that know no KDE3 take their GNOME path, so Chromium and the Electron
# applications keep their passwords in the GNOME keyring (libsecret) and
# xdg-open uses gio.  The GNOME-only autostart entries are still not
# started (see kinit/autostart.cpp in kdelibs), and kde3-portals.conf
# chooses the portal backends instead of gnome-portals.conf.
# A display manager sets XDG_CURRENT_DESKTOP from DesktopNames=KDE3;GNOME;
# of the session file; a value that does not start with KDE3 was inherited
# from somewhere else (startx from another desktop's terminal, a session
# file without DesktopNames) and is replaced, and so are the session names
# that came with it.
case "$XDG_CURRENT_DESKTOP" in
  KDE3|KDE3:*) ;;
  *) XDG_CURRENT_DESKTOP=KDE3:GNOME; export XDG_CURRENT_DESKTOP
     unset XDG_SESSION_DESKTOP DESKTOP_SESSION ;;
esac
if test -z "$XDG_SESSION_DESKTOP"; then
  XDG_SESSION_DESKTOP=KDE3; export XDG_SESSION_DESKTOP
fi
if test -z "$DESKTOP_SESSION"; then
  DESKTOP_SESSION=kde3; export DESKTOP_SESSION
fi

# Set the background to plain black.
# The standard X background is nasty, causing moire effects and exploding
# people's heads.
if test -z "$XDM_MANAGED" || echo "$XDM_MANAGED" | grep ",auto" > /dev/null; then
  kstartupx --black-root
fi

# we have to unset this for Darwin since it will screw up KDE's dynamic-loading
unset DYLD_FORCE_FLAT_NAMESPACE

# Boot sequence:
#
# kdeinit is used to fork off processes which improves memory usage
# and startup time.
#
# * kdeinit starts the dcopserver and klauncher first.
# * Then kded is started. kded is responsible for keeping the sycoca
#   database up to date. When an up to date database is present it goes
#   into the background and the startup continues.
# * Then kdeinit starts kcminit. kcminit performs initialisation of
#   certain devices according to the user's settings
#
# * Then ksmserver is started which takes control of the rest of the startup sequence

# The user's personal KDE directory is usually ~/.kde, but this setting
# may be overridden by setting KDEHOME.

kdehome=$HOME/.kde
test -n "$KDEHOME" && kdehome=`echo "$KDEHOME"|sed "s,^~/,$HOME/,"`

# see kstartupconfig source for usage
mkdir -m 700 -p $kdehome
mkdir -m 700 -p $kdehome/share
mkdir -m 700 -p $kdehome/share/config
cat >$kdehome/share/config/startupconfigkeys <<EOF
kcminputrc Mouse cursorTheme ''
kcminputrc Mouse cursorSize ''
ksplashrc KSplash Theme Default
kcmfonts General forceFontDPI 0
ksmserverrc General SeparateDconf true
EOF
kstartupconfig
if test $? -ne 0; then
    kstartupx --message "Could not start kstartupconfig. Check your installation."
fi
. $kdehome/share/config/startupconfig

# XCursor mouse theme needs to be applied here to work even for kded or ksmserver
if test -n "$kcminputrc_mouse_cursortheme" -o -n "$kcminputrc_mouse_cursorsize" ; then
    kapplymousetheme "$kcminputrc_mouse_cursortheme" "$kcminputrc_mouse_cursorsize"
    if test $? -eq 10; then
        export XCURSOR_THEME=default
    elif test -n "$kcminputrc_mouse_cursortheme"; then
        export XCURSOR_THEME="$kcminputrc_mouse_cursortheme"
    fi
    if test -n "$kcminputrc_mouse_cursorsize"; then
        export XCURSOR_SIZE="$kcminputrc_mouse_cursorsize"
    fi
fi

# Arrange the monitors as saved in the Control Center (displayrc, one
# profile per set of connected monitors); kded_randr does it again when
# monitors are connected or disconnected.
krandrstartup

dl=$DESKTOP_LOCKED
unset DESKTOP_LOCKED # Don't want it in the environment

# Launch splash that doesn't need any KDE libraries here, before
# KDE libraries are loaded into memory (which may take some time
# with cold caches). Makes the splash appear sooner.
if test -z "$dl"; then
    case "$ksplashrc_ksplash_theme" in 
      Simple)
         ksplashsimple 
         ;;
      *)
         ;;
    esac
fi

if test "$kcmfonts_general_forcefontdpi" -eq 120; then
    xrdb -quiet -merge -nocpp <<EOF
Xft.dpi: 120
EOF
elif test "$kcmfonts_general_forcefontdpi" -eq 96; then
    xrdb -quiet -merge -nocpp <<EOF
Xft.dpi: 96
EOF
fi

# Source scripts found in <localprefix>/env/*.sh and <prefixes>/env/*.sh
# (where <localprefix> is $KDEHOME or ~/.kde, and <prefixes> is where KDE is installed)
#
# This is where you can define environment variables that will be available to
# all KDE programs, so this is where you can run agents using e.g. eval `ssh-agent`
# or eval `gpg-agent --daemon`.
# Note: if you do that, you should also put "ssh-agent -k" as a shutdown script
#
# (see end of this file).
# For anything else (that doesn't set env vars, or that needs a window manager),
# better use the Autostart folder.

exepath=`kde-config --path exe | tr : '\n'`

for prefix in `echo "$exepath" | sed -n -e 's,/bin[^/]*/,/env/,p'`; do
  for file in "$prefix"*.sh; do
    test -r "$file" && . "$file"
  done
done

# Without a theme or size of the mouse module, the ones libXcursor takes
# (its resources, else the theme "default" and a size from Xft.dpi or the
# screen), so that toolkits that read the environment (Qt 5/6, SDL, Java,
# ...) show the same cursors as the X clients and as kded_xsettings tells
# GTK.  (Resources krdb merges later, ~/.Xresources when the display
# manager has not loaded it, are not seen here.)
if test -z "$XCURSOR_THEME" -o -z "$XCURSOR_SIZE"; then
    xcursor_defaults=`kapplymousetheme --defaults 2>/dev/null`
    # (the size on the last line: a theme name may hold anything)
    xcursor_nl='
'
    xcursor_theme=${xcursor_defaults%"$xcursor_nl"*}
    xcursor_size=${xcursor_defaults##*"$xcursor_nl"}
    if test -z "$XCURSOR_THEME" -a -n "$xcursor_theme"; then
        export XCURSOR_THEME="$xcursor_theme"
    fi
    if test -z "$XCURSOR_SIZE" && test "${xcursor_size:-0}" -gt 0 2>/dev/null; then
        export XCURSOR_SIZE="$xcursor_size"
    fi
    unset xcursor_defaults xcursor_theme xcursor_size xcursor_nl
fi

# Fonts: Qt3 uses Xft, so fonts are found through fontconfig (~/.fonts is
# in fontconfig's default configuration).  The X server's core font path
# is not changed: nothing in KDE uses core (XLFD) fonts from the KDE font
# directories any more.

usr_fdir=$HOME/.fonts

# Set a left cursor instead of the standard X11 "X" cursor, since I've heard
# from some users that they're confused and don't know what to do. This is
# especially necessary on slow machines, where starting KDE takes one or two
# minutes until anything appears on the screen.
#
kstartupx --root-cursor

# Get Ghostscript to look into user's KDE fonts dir for additional Fontmap
if test -n "$GS_LIB" ; then
    GS_LIB=$usr_fdir:$GS_LIB
    export GS_LIB
else
    GS_LIB=$usr_fdir
    export GS_LIB
fi

# Link "tmp" "socket" and "cache" resources to directory in /tmp
# Creates:
# - a directory /tmp/kde-$USER and links $KDEHOME/tmp-$HOSTNAME to it.
# - a directory /tmp/ksocket-$USER and links $KDEHOME/socket-$HOSTNAME to it.
# - a directory /var/tmp/kdecache-$USER and links $KDEHOME/cache-$HOSTNAME to it.
# Note: temporary locations can be overriden through the KDETMP and KDEVARTMP
# environment variables
for resource in tmp cache socket; do
    if ! lnusertemp $resource >/dev/null; then
        echo 'startkde: Call to lnusertemp failed (temporary directories full?). Check your installation.'  1>&2
        kstartupx --message "Call to lnusertemp failed (temporary directories full?). Check your installation."
        exit 1
    fi
done

# In case of dcop sockets left by a previous session, cleanup
dcopserver_shutdown

echo 'startkde: Starting up...'  1>&2

if test -z "$dl"; then
  # the splashscreen and progress indicator
  case "$ksplashrc_ksplash_theme" in 
    None)
       ;; # nothing
    Simple)
       ;; # started earlier
    *)
       ksplash --nodcop
       ;;
  esac
fi

# Mark that full KDE session is running (e.g. Konqueror preloading works only
# with full KDE running). The KDE_FULL_SESSION property can be detected by
# any X client connected to the same X session, even if not launched
# directly from the KDE session but e.g. using "ssh -X", kdesu. $KDE_FULL_SESSION
# however guarantees that the application is launched in the same environment
# like the KDE session and that e.g. KDE utilities/libraries are available.
# KDE_FULL_SESSION property is also only available since KDE 3.5.5.
# The matching tests are:
#   For $KDE_FULL_SESSION:
#     if test -n "$KDE_FULL_SESSION"; then ... whatever
#   For KDE_FULL_SESSION property:
#     xprop -root | grep "^KDE_FULL_SESSION" >/dev/null 2>/dev/null
#     if test $? -eq 0; then ... whatever
#   (startkde itself sets and removes the property with kstartupx)
#
# Additionally there is (since KDE 3.5.7) $KDE_SESSION_UID with the uid
# of the user running the KDE session. It should be rarely needed (e.g.
# after sudo to prevent desktop-wide functionality in the new user's kded).
#
KDE_FULL_SESSION=true
export KDE_FULL_SESSION
kstartupx --set-full-session
KDE_SESSION_UID=$UID
export KDE_SESSION_UID

# The session's own dconf (GSettings) database.  The GNOME and GTK
# applications read some of their settings from GSettings rather than
# from XSETTINGS or the Settings portal (libadwaita's document and
# monospace fonts, GNOME Terminal's font, ...).  So that they follow KDE
# without changing the user's GNOME settings, the KDE 3 session has its
# own database, ~/.config/dconf/kde3 (user-db:kde3), through a dconf
# profile in $XDG_RUNTIME_DIR named by DCONF_PROFILE; kded_xsettings
# keeps the KDE-derived keys of org.gnome.desktop.interface there.
# The profile has the system databases of the default profile ("user",
# in /etc or $XDG_DATA_DIRS) after it; a default profile whose writable
# database is not user-db:user is left alone (no separate database).
# The first KDE 3 login copies the user's database (read only) into the
# new one, so that everything else stays as in GNOME.
# Not done with a mandatory profile (/run/dconf/user/<uid>), which dconf
# prefers to DCONF_PROFILE, or with [General] SeparateDconf=false in
# ksmserverrc.  DCONF_PROFILE goes to the D-Bus and systemd activated
# services too (below) and is taken from them again at logout
# (kde3_dconf_cleanup), as gnome-session does not reset it.
kde3_dconf_profile=
kde3_dconf_setup()
{
  # one inherited from a KDE 3 session (startx from its terminal)
  case "$DCONF_PROFILE" in
    */kde3/dconf-profile) unset DCONF_PROFILE ;;
  esac
  test "$ksmserverrc_general_separatedconf" = "false" && return
  test -n "$XDG_RUNTIME_DIR" && test -d "$XDG_RUNTIME_DIR" || return
  test -e /run/dconf/user/`id -u` && return
  # the default profile, where dconf looks for it
  userprofile=
  for d in /etc `echo "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr : ' '`; do
    if test -e "$d/dconf/profile/user"; then
      userprofile=$d/dconf/profile/user
      break
    fi
  done
  mkdir -m 700 -p "$XDG_RUNTIME_DIR/kde3" || return
  profile=$XDG_RUNTIME_DIR/kde3/dconf-profile
  if test -n "$userprofile"; then
    # its lines without comments and blanks; the first one must be the
    # user's database, which becomes the session's
    lines=`sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$userprofile"` || return
    test "`echo "$lines" | head -n 1`" = "user-db:user" || return
    { echo "user-db:kde3"; echo "$lines" | sed 1d; } >"$profile.tmp" || return
  else
    echo "user-db:kde3" >"$profile.tmp" || return
  fi
  mv -f "$profile.tmp" "$profile" || return
  # the first login: a copy of the user's database (dconf-service
  # replaces the file at once when it writes, so the copy is whole)
  dconfdir=${XDG_CONFIG_HOME:-$HOME/.config}/dconf
  if test ! -e "$dconfdir/kde3" && test -f "$dconfdir/user"; then
    if cp "$dconfdir/user" "$dconfdir/kde3.tmp$$"; then
      mv -f "$dconfdir/kde3.tmp$$" "$dconfdir/kde3"
    else
      rm -f "$dconfdir/kde3.tmp$$"
    fi
  fi
  DCONF_PROFILE=$profile; export DCONF_PROFILE
  kde3_dconf_profile=$profile
  unset userprofile profile lines dconfdir
}
kde3_dconf_setup

# At logout (or when killed): the systemd user manager outlives the
# session (lingering, a GNOME login after this one), so DCONF_PROFILE is
# removed from the environment of the services it starts (dbus-broker
# passes the D-Bus activation environment on to it as well), and the
# portal services started for this session, which read GSettings
# (xdg-desktop-portal-gtk) or the desktop's name (xdg-desktop-portal),
# are stopped: they are started again on demand, with the next
# session's environment.
kde3_dconf_cleanup()
{
  test -n "$kde3_dconf_profile" || return
  kde3_dconf_profile=
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user unset-environment DCONF_PROFILE 2>/dev/null
    systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-gtk.service \
      xdg-desktop-portal-gnome.service 2>/dev/null
  fi
}
trap 'kde3_dconf_cleanup; exit 1' TERM INT
# The same from outside the session, should startkde not get there
# (killed with SIGKILL, hanging): a transient unit of the user manager
# that waits for this script.  Limits: other services activated for
# this session that read GSettings (gnome-terminal-server, ...) keep the
# variable until they exit, and two KDE 3 sessions of one user at once
# share the profile, so the first logout takes it from the second's
# activated services.
if test -n "$kde3_dconf_profile" && command -v systemd-run >/dev/null 2>&1; then
  systemd-run --user --collect --quiet sh -c "while kill -0 $$ 2>/dev/null; do sleep 5; done; \
    systemctl --user unset-environment DCONF_PROFILE; \
    systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-gtk.service \
      xdg-desktop-portal-gnome.service" >/dev/null 2>&1
fi

# The services that D-Bus and the systemd user manager start on demand
# (xdg-desktop-portal and its backends, gnome-keyring, ...) do not inherit
# the session's environment: give them the display and the desktop's
# names, as the other desktops do, so that xdg-desktop-portal reads
# kde3-portals.conf (found through XDG_DATA_DIRS when KDE is not installed
# in /usr).  Only when a session bus is there: without one, D-Bus would
# start a new bus for the X display.
if test -n "$DBUS_SESSION_BUS_ADDRESS" || test -S "$XDG_RUNTIME_DIR/bus"; then
  session_env="DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP DESKTOP_SESSION XDG_DATA_DIRS XDG_CONFIG_DIRS"
  # xdg-desktop-portal-kde3 reads KDE's configuration and the cursor
  for v in KDEHOME KDEDIRS XCURSOR_THEME XCURSOR_SIZE DCONF_PROFILE; do
    eval "test -n \"\${$v}\"" && session_env="$session_env $v"
  done
  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd $session_env
  elif command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment $session_env 2>/dev/null
  fi
  unset session_env
fi

# We set LD_BIND_NOW to increase the efficiency of kdeinit.
# kdeinit unsets this variable before loading applications.
LD_BIND_NOW=true start_kdeinit_wrapper --new-startup +kcminit_startup
if test $? -ne 0; then
  # Startup error
  echo 'startkde: Could not start kdeinit. Check your installation.'  1>&2
  kstartupx --message "Could not start kdeinit. Check your installation."
fi

# If the session should be locked from the start (locked autologin),
# lock now and do the rest of the KDE startup underneath the locker.
if test -n "$dl"; then
  kwrapper kdesktop_lock --forcelock &
  # Give it some time for starting up. This is somewhat unclean; some
  # notification would be better.
  sleep 1
fi

# finally, give the session control to the session manager
# see kdebase/ksmserver for the description of the rest of the startup sequence
# if the KDEWM environment variable has been set, then it will be used as KDE's
# window manager instead of kwin.
# if KDEWM is not set, ksmserver will ensure kwin is started.
# kwrapper is used to reduce startup time and memory usage
# kwrapper does not return usefull error codes such as the exit code of ksmserver.
# We only check for 255 which means that the ksmserver process could not be 
# started, any problems thereafter, e.g. ksmserver failing to initialize, 
# will remain undetected.
test -n "$KDEWM" && KDEWM="--windowmanager $KDEWM"
kwrapper ksmserver $KDEWM 
if test $? -eq 255; then
  # Startup error
  echo 'startkde: Could not start ksmserver. Check your installation.'  1>&2
  kstartupx --message "Could not start ksmserver. Check your installation."
fi

# wait if there's any crashhandler shown
while dcop | grep -q ^drkonqi- ; do
    sleep 5
done

echo 'startkde: Shutting down...'  1>&2

# Clean up
kdeinit_shutdown
dcopserver_shutdown --wait
# KDE4 support
kde4 kdeinit4_shutdown 2>/dev/null

kde3_dconf_cleanup

echo 'startkde: Running shutdown scripts...'  1>&2

# Run scripts found in $KDEDIRS/shutdown
for prefix in `echo "$exepath" | sed -n -e 's,/bin[^/]*/,/shutdown/,p'`; do
  for file in `ls "$prefix" 2> /dev/null | egrep -v '(~|\.bak)$'`; do
    test -x "$prefix$file" && "$prefix$file"
  done
done

unset KDE_FULL_SESSION
kstartupx --remove-full-session
unset KDE_SESSION_UID

echo 'startkde: Done.'  1>&2
