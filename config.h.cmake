/* config.h, generated by CMake from config.h.cmake.
 *
 * Only what the kdebase sources test is defined here (see
 * ConfigureChecks.cmake); the autotools config.h also carried fallback
 * prototypes and portability blocks for systems that are not supported
 * any more.
 */

/* ---- paths and build information ---------------------------------- */

/* Name and version of package */
#define PACKAGE "kdebase"
#define VERSION "@KDEBASE_VERSION@"

/* KDE's configuration directory */
#define KDE_CONFDIR "@KDE_CONFDIR@"
/* KDE's static data directory */
#define KDE_DATADIR "@KDE_DATADIR@"
/* KDE's binaries directory */
#define KDE_BINDIR "@KDE_BINDIR@"

/* X binaries directory */
#define XBINDIR "@XBINDIR@"
/* X libraries directory */
#define XLIBDIR "@XLIBDIR@"

/* ---- system ------------------------------------------------------- */

/* type to use in place of socklen_t if not defined */
#define kde_socklen_t socklen_t

/* headers */
#cmakedefine HAVE_CRYPT_H 1
#cmakedefine HAVE_FSTAB_H 1
#cmakedefine HAVE_LASTLOG_H 1
#cmakedefine HAVE_LIBUTIL_H 1
#cmakedefine HAVE_LIMITS_H 1
#cmakedefine HAVE_MNTENT_H 1
#cmakedefine HAVE_PATHS_H 1
#cmakedefine HAVE_PTY_H 1
#cmakedefine HAVE_STRING_H 1
#cmakedefine HAVE_SYS_IOCTL_H 1
#cmakedefine HAVE_SYS_LOADAVG_H 1
#cmakedefine HAVE_SYS_SELECT_H 1
#cmakedefine HAVE_SYS_SOCKET_H 1
#cmakedefine HAVE_SYS_SOCKIO_H 1
#cmakedefine HAVE_SYS_STAT_H 1
#cmakedefine HAVE_SYS_TIME_H 1
#cmakedefine HAVE_SYS_TYPES_H 1
#cmakedefine HAVE_SYS_WAIT_H 1
#cmakedefine HAVE_TERMIOS_H 1
#cmakedefine HAVE_TERMIO_H 1
#cmakedefine HAVE_UNISTD_H 1
#cmakedefine HAVE_UTIL_H 1

/* Define to 1 if you can safely include both <sys/time.h> and <time.h>. */
#cmakedefine TIME_WITH_SYS_TIME 1

/* functions */
#cmakedefine HAVE_GETDOMAINNAME 1
#cmakedefine HAVE_GETPASSPHRASE 1
#cmakedefine HAVE_GETPEEREID 1
#cmakedefine HAVE_GETPT 1
#cmakedefine HAVE_GRANTPT 1
#cmakedefine HAVE_INITGROUPS 1
#cmakedefine HAVE_MKSTEMP 1
#cmakedefine HAVE_NICE 1
#cmakedefine HAVE_OPENPTY 1
#cmakedefine HAVE_PW_ENCRYPT 1
#cmakedefine HAVE_SETPRIORITY 1

/* Defines if your system has the crypt function */
#cmakedefine HAVE_CRYPT 1

/* types and members */
#cmakedefine HAVE_STRUCT_UCRED 1

/* ---- X11 ---------------------------------------------------------- */

/* Define if you have the XTest extension */
#cmakedefine HAVE_XTEST 1
/* Define if you have the XKB extension */
#cmakedefine HAVE_XKB 1
/* Define if you have XkbSetPerClientControls */
#cmakedefine HAVE_XKBSETPERCLIENTCONTROLS 1
/* Define to 1 if you have Xcursor */
#cmakedefine HAVE_XCURSOR 1
/* Defined if your system has XRender support */
#cmakedefine HAVE_XRENDER 1

/* ---- passwords ---------------------------------------------------- */

/* Defines if you have PAM (Pluggable Authentication Modules) */
#cmakedefine HAVE_PAM 1
/* Define if your PAM headers are in pam/ instead of security/ */
#cmakedefine HAVE_PAM_PAM_APPL_H 1
/* Define if your PAM support takes non-const arguments (Solaris) */
#cmakedefine PAM_MESSAGE_NONCONST 1
/* The PAM services to be used by kdm, kcheckpass and kscreensaver */
#cmakedefine KDM_PAM_SERVICE "@KDM_PAM_SERVICE@"
#cmakedefine KCHECKPASS_PAM_SERVICE "@KCHECKPASS_PAM_SERVICE@"
#cmakedefine KSCREENSAVER_PAM_SERVICE "@KSCREENSAVER_PAM_SERVICE@"
/* Define if you use shadow passwords */
#cmakedefine HAVE_SHADOW 1

/* ---- kdesu -------------------------------------------------------- */

/* Use su or sudo */
#define DEFAULT_SUPER_USER_COMMAND "@DEFAULT_SUPER_USER_COMMAND@"

/* ---- klipper, ksmserver ------------------------------------------- */

/* Define if you have the XFixes extension */
#cmakedefine HAVE_XFIXES 1
/* Define to 1 if you have the `_IceTransNoListen' function. */
#cmakedefine HAVE__ICETRANSNOLISTEN 1

/* ---- khotkeys ----------------------------------------------------- */

/* Define if covariant return in virtual methods does not work */
#cmakedefine COVARIANT_RETURN_BROKEN 1

/* ---- konsole ------------------------------------------------------ */

/* Defines whether /proc/`pid`/cwd exists */
#cmakedefine HAVE_PROC_CWD 1

/* ---- kdeprint ----------------------------------------------------- */

#cmakedefine HAVE_SIGSET 1
#cmakedefine HAVE_SIGACTION 1

/* ---- ksplashml ---------------------------------------------------- */

/* Define if you have the Xinerama extension */
#cmakedefine HAVE_XINERAMA 1

/* ---- ksysguard ---------------------------------------------------- */

/* Define to 1 if you have the <sensors/sensors.h> header file. */
#cmakedefine HAVE_SENSORS_SENSORS_H 1
/* Define if dns-sd is available */
#cmakedefine HAVE_DNSSD 1

/* ---- kicker ------------------------------------------------------- */

/* Define if you have the XComposite extension */
#cmakedefine HAVE_XCOMPOSITE 1

/* ---- kdesktop ----------------------------------------------------- */

/* Define if you have the XScreenSaver extension */
#cmakedefine HAVE_XSCREENSAVER 1
/* Define if you have the xf86misc extension */
#cmakedefine HAVE_XF86MISC 1
/* Define if you have XF86MiscSetGrabKeysState() */
#cmakedefine HAVE_XF86MISCSETGRABKEYSSTATE 1
/* Define if you have glXChooseVisual() */
#cmakedefine HAVE_GLXCHOOSEVISUAL 1

/* ---- kcontrol ----------------------------------------------------- */

/* If we are going to use OpenSSL */
#cmakedefine HAVE_SSL 1
/* Define if you have DPMS support */
#cmakedefine HAVE_DPMS 1
/* Define if you have the DPMSCapable prototype in <X11/extensions/dpms.h> */
#cmakedefine HAVE_DPMSCAPABLE_PROTO 1
/* Define if you have the DPMSInfo prototype in <X11/extensions/dpms.h> */
#cmakedefine HAVE_DPMSINFO_PROTO 1
/* Defines if your system has the libfontconfig library */
#cmakedefine HAVE_FONTCONFIG 1
/* Define if you have FreeType2 library */
#cmakedefine HAVE_FREETYPE2 1
/* Defines if you have Xft */
#cmakedefine HAVE_XFT 1
#cmakedefine HAVE_LINUX_RAW_H 1
#cmakedefine HAVE_SYS_RAW_H 1
#cmakedefine HAVE_DEVINFO_H 1
/* Define if you have long long as datatype */
#cmakedefine HAVE_LONG_LONG 1
/* Defined if you have libusb */
#cmakedefine HAVE_LIBUSB 1
#cmakedefine HAVE_GETIFADDRS 1
#cmakedefine HAVE_GETNAMEINFO 1
/* Define to 1 if `sa_len' is a member of `struct sockaddr'. */
#cmakedefine HAVE_STRUCT_SOCKADDR_SA_LEN 1
/* The size of `long', as computed by sizeof. */
#define SIZEOF_LONG @SIZEOF_LONG@

/* ---- konqueror ---------------------------------------------------- */

/* mallinfo() is available in <stdlib.h> / <malloc.h> */
#cmakedefine KDE_MALLINFO_STDLIB 1
#cmakedefine KDE_MALLINFO_MALLOC 1
/* Use mallinfo field hblkhd / uordblks / usmblks */
#cmakedefine KDE_MALLINFO_FIELD_hblkhd 1
#cmakedefine KDE_MALLINFO_FIELD_uordblks 1
#cmakedefine KDE_MALLINFO_FIELD_usmblks 1
